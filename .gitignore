# ==============================================================================
# Instagram Vault & AI Studio - Production .gitignore
# ==============================================================================

# --- Secrets, Credentials & Sessions (CRITICAL PRIVACY) ---
.env
.env.*
!.env.example
session.json
session.enc
*.enc
*.key
*.pem
*.cert
cookies.txt

# --- Personal Data, Media & Database ---
archive/
your_instagram_activity/
temp_exports/
media/
downloads/
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3

# --- Python & Virtual Environments ---
venv/
env/
.venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# --- Desktop Frontend (Electron, Node, Vite) ---
desktop/node_modules/
desktop/dist/
desktop/dist-electron/
desktop/release/
desktop/release-next/
desktop/backend-build/
desktop/backend-build*/
.build-deps/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Temporary Test & Smoke Artifacts ---
.smoke*
.catalog-check*
.export-check*
.p1-p2-test*
.packaged-smoke*
*.part

# --- Operating System & Logs ---
*.log
*.tmp
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- IDE & Editor Configuration ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

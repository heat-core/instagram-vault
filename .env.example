# ==============================================================================
# Instagram Vault & AI Studio - Environment Configuration Template
# ==============================================================================
# Note: You can configure all of these settings directly inside the Desktop App
# under the "Settings" tab. This file is optional for standalone backend runs.

# --- AI Vision & Taxonomy Provider ---
# Supported providers: '9router', 'openrouter', 'google', 'custom'
AI_PROVIDER=9router
AI_MODEL=gemini-2.5-flash
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.openai.com/v1

# --- Optional Download & Proxy Configurations ---
# List proxies for rotating downloads (one per line or comma-separated)
# Example: http://127.0.0.1:10809,socks5://127.0.0.1:10808
PROXIES=

# Maximum downloads per 24-hour window (default: 5000)
DAILY_DOWNLOAD_LIMIT=5000

# Download concurrency (default: 1 for safe rate limiting)
DOWNLOAD_CONCURRENCY=1
